{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-macos",
      "hidden": true,
      "description": "Common settings for all macOS builds",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_FLAGS": "-DPTPD_LIBRARY_MODE=1",
        "ENABLE_PCAP": "ON",
        "ENABLE_SNMP": "OFF",
        "ENABLE_STATISTICS": "ON",
        "ENABLE_DAEMON": "OFF",
        "ENABLE_RUNTIME_DEBUG": "ON",
        "BUILD_WITH_SWCLOCK": "ON"
      }
    },
    {
      "name": "base-ios",
      "hidden": true,
      "description": "Common settings for all iOS builds",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build-cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH": "NO",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_FLAGS": "-DPTPD_IOS=1 -DPTPD_LIBRARY_MODE=1",
        "ENABLE_PCAP": "OFF",
        "ENABLE_SNMP": "OFF",
        "ENABLE_DAEMON": "OFF",
        "ENABLE_RUNTIME_DEBUG": "ON",
        "BUILD_WITH_SWCLOCK": "ON"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "description": "macOS debug build — produces libptpd2.a + libswclock.a",
      "inherits": "base-macos",
      "binaryDir": "${sourceDir}/build-cmake/macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "description": "macOS optimised release build — produces libptpd2.a + libswclock.a",
      "inherits": "base-macos",
      "binaryDir": "${sourceDir}/build-cmake/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ios-simulator-debug",
      "displayName": "iOS Simulator Debug",
      "description": "iOS Simulator debug build (arm64 + x86_64) — produces libptpd2.a + libswclock.a",
      "inherits": "base-ios",
      "binaryDir": "${sourceDir}/build-cmake/ios-simulator-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },
    {
      "name": "ios-simulator-release",
      "displayName": "iOS Simulator Release",
      "description": "iOS Simulator release build (arm64 + x86_64) — produces libptpd2.a + libswclock.a",
      "inherits": "base-ios",
      "binaryDir": "${sourceDir}/build-cmake/ios-simulator-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },
    {
      "name": "ios-debug",
      "displayName": "iOS Device Debug",
      "description": "iOS device debug build (arm64) — produces libptpd2.a + libswclock.a",
      "inherits": "base-ios",
      "binaryDir": "${sourceDir}/build-cmake/ios-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "ios-release",
      "displayName": "iOS Device Release",
      "description": "iOS device release build (arm64) — produces libptpd2.a + libswclock.a",
      "inherits": "base-ios",
      "binaryDir": "${sourceDir}/build-cmake/ios-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },

    {
      "name": "macos-gtest-debug",
      "displayName": "macOS GTest Debug",
      "description": "macOS debug GTest suite — links to macos-debug library, does not rebuild it",
      "inherits": "base-macos",
      "binaryDir": "${sourceDir}/build-cmake/macos-gtest-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PTPD_PREBUILT_DIR": "${sourceDir}/build-cmake/macos-debug",
        "BUILD_PTPD_TESTS": "ON"
      }
    },
    {
      "name": "macos-gtest-release",
      "displayName": "macOS GTest Release",
      "description": "macOS release GTest suite — links to macos-release library, does not rebuild it",
      "inherits": "base-macos",
      "binaryDir": "${sourceDir}/build-cmake/macos-gtest-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PTPD_PREBUILT_DIR": "${sourceDir}/build-cmake/macos-release",
        "BUILD_PTPD_TESTS": "ON"
      }
    },
    {
      "name": "macos-ptpd-app-debug",
      "displayName": "macOS ptpd-app Debug",
      "description": "macOS debug ptpd-app — links to macos-debug library, does not rebuild it",
      "inherits": "base-macos",
      "binaryDir": "${sourceDir}/build-cmake/macos-ptpd-app-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PTPD_PREBUILT_DIR": "${sourceDir}/build-cmake/macos-debug",
        "BUILD_PTPD_APP": "ON"
      }
    },
    {
      "name": "macos-ptpd-app-release",
      "displayName": "macOS ptpd-app Release",
      "description": "macOS release ptpd-app — links to macos-release library, does not rebuild it",
      "inherits": "base-macos",
      "binaryDir": "${sourceDir}/build-cmake/macos-ptpd-app-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PTPD_PREBUILT_DIR": "${sourceDir}/build-cmake/macos-release",
        "BUILD_PTPD_APP": "ON"
      }
    },
    {
      "name": "iossim-ptpd-app-debug",
      "displayName": "iOS Simulator ptpd-app Debug",
      "description": "iOS Simulator debug PTP Monitor app — links to ios-simulator-debug library, does not rebuild it",
      "inherits": "base-ios",
      "binaryDir": "${sourceDir}/build-cmake/iossim-ptpd-app-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "PTPD_PREBUILT_DIR": "${sourceDir}/build-cmake/ios-simulator-debug",
        "BUILD_IOS_APP": "ON"
      }
    },
    {
      "name": "iossim-ptpd-app-release",
      "displayName": "iOS Simulator ptpd-app Release",
      "description": "iOS Simulator release PTP Monitor app — links to ios-simulator-release library, does not rebuild it",
      "inherits": "base-ios",
      "binaryDir": "${sourceDir}/build-cmake/iossim-ptpd-app-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "PTPD_PREBUILT_DIR": "${sourceDir}/build-cmake/ios-simulator-release",
        "BUILD_IOS_APP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "configurePreset": "macos-debug",
      "jobs": 4
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "configurePreset": "macos-release",
      "jobs": 4
    },
    {
      "name": "ios-simulator-debug",
      "displayName": "iOS Simulator Debug",
      "configurePreset": "ios-simulator-debug",
      "configuration": "Debug"
    },
    {
      "name": "ios-simulator-release",
      "displayName": "iOS Simulator Release",
      "configurePreset": "ios-simulator-release",
      "configuration": "Release"
    },
    {
      "name": "ios-debug",
      "displayName": "iOS Device Debug",
      "configurePreset": "ios-debug",
      "configuration": "Debug"
    },
    {
      "name": "ios-release",
      "displayName": "iOS Device Release",
      "configurePreset": "ios-release",
      "configuration": "Release"
    },

    {
      "name": "macos-gtest-debug",
      "displayName": "macOS GTest Debug",
      "configurePreset": "macos-gtest-debug",
      "jobs": 4
    },
    {
      "name": "macos-gtest-release",
      "displayName": "macOS GTest Release",
      "configurePreset": "macos-gtest-release",
      "jobs": 4
    },
    {
      "name": "macos-ptpd-app-debug",
      "displayName": "macOS ptpd-app Debug",
      "configurePreset": "macos-ptpd-app-debug",
      "jobs": 4
    },
    {
      "name": "macos-ptpd-app-release",
      "displayName": "macOS ptpd-app Release",
      "configurePreset": "macos-ptpd-app-release",
      "jobs": 4
    },
    {
      "name": "iossim-ptpd-app-debug",
      "displayName": "iOS Simulator ptpd-app Debug",
      "configurePreset": "iossim-ptpd-app-debug",
      "configuration": "Debug"
    },
    {
      "name": "iossim-ptpd-app-release",
      "displayName": "iOS Simulator ptpd-app Release",
      "configurePreset": "iossim-ptpd-app-release",
      "configuration": "Release"
    }
  ]
}
