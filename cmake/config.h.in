/* config.h.in - CMake configuration template for ptpd
 * Generated by CMake from cmake/config.h.in
 * This file matches the autotools config.h.in functionality
 */

#ifndef CONFIG_H
#define CONFIG_H

/* Build date year-month-day */
#cmakedefine BUILD_DATE "@BUILD_DATE@"

/* Source code revision */
#cmakedefine CODE_REVISION "@CODE_REVISION@"

/* Package information */
#define PACKAGE "@PROJECT_NAME@"
#define PACKAGE_NAME "@PROJECT_NAME@"
#define VERSION "@PROJECT_VERSION@"
#define PACKAGE_VERSION "@PROJECT_VERSION@"
#define PACKAGE_STRING "@PROJECT_NAME@ @PROJECT_VERSION@"
#define PACKAGE_TARNAME "@PROJECT_NAME@"
#define PACKAGE_URL "https://github.com/ptpd/ptpd"
#define PACKAGE_BUGREPORT "ptpd-bugs@nwtime.org"

/* Header files */
#cmakedefine HAVE_ARPA_INET_H 1
