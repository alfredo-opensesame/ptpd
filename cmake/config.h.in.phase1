/* config.h - Minimal configuration for Phase 1 CMake build
 * This is a simplified config.h for initial CMake testing.
 * Phase 2 will add comprehensive platform detection matching autotools.
 */

#ifndef CONFIG_H
#define CONFIG_H

/* Package information */
#define PACKAGE "ptpd"
#define PACKAGE_NAME "ptpd"
#define VERSION "2.3.1"
#define PACKAGE_VERSION "2.3.1"
#define PACKAGE_STRING "ptpd 2.3.1"

/* Build date (will be generated at configure time) */
#define BUILD_DATE "@BUILD_DATE@"

/* Common headers that exist on macOS and Linux */
#define HAVE_ARPA_INET_H 1
#define HAVE_FCNTL_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_LIMITS_H 1
#define HAVE_NETDB_H 1
#define HAVE_NETINET_IN_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1#define HAVE_STRING_H 1
#define HAVE_STRINGS_H 1
#define HAVE_SYS_IOCTL_H 1
#define HAVE_SYS_PARAM_H 1
#define HAVE_SYS_SOCKET_H 1
#define HAVE_SYS_TIME_H 1
#define HAVE_SYSLOG_H 1
#define HAVE_UNISTD_H 1
#define HAVE_SYS_UIO_H 1
#define HAVE_GETOPT_H 1
#define HAVE_GLOB_H 1
#define HAVE_MATH_H 1
#define HAVE_NET_IF_H 1
#define HAVE_IFADDRS_H 1
#define HAVE_SCHED_H 1
#define HAVE_SYS_SOCKIO_H 1

/* macOS-specific headers */
#ifdef __APPLE__
#define HAVE_MACHINE_ENDIAN_H 1
#define HAVE_UTMPX_H 1
#define HAVE_SYS_TIMEX_H 1
#define HAVE_NET_IF_ARP_H 1
#define HAVE_NETINET_IF_ETHER_H 1
#define HAVE_NETINET_IN_SYSTM_H 1
/* HAVE_NETINET_ETHER_H - not defined, header doesn't exist on macOS */
#define HAVE_NET_ETHERNET_H 1
#define HAVE_UTMP_H 1
#endif

/* Linux-specific headers */
#ifdef __linux__
#define HAVE_ENDIAN_H 1
#define HAVE_NET_ETHERNET_H 1
#define HAVE_LINUX_NET_TSTAMP_H 1
#endif

/* PCAP headers - assume present since we require PCAP in Phase 1 */
#define HAVE_PCAP_PCAP_H 1

/* Common functions */
#define HAVE_CLOCK_GETTIME 1
#define HAVE_GETTIMEOFDAY 1
#define HAVE_MEMSET 1
#define HAVE_SOCKET 1
#define HAVE_SELECT 1
#define HAVE_STRFTIME 1
#define HAVE_STRCHR 1
#define HAVE_STRDUP 1
#define HAVE_STRERROR 1
#define HAVE_STRTOL 1
#define HAVE_VPRINTF 1
#define HAVE_POW 1
#define HAVE_DUP2 1
#define HAVE_FTRUNCATE 1
#define HAVE_INET_NTOA 1
#define HAVE_SIGNAL 1
#define HAVE_GLOB 1
#define HAVE_GETOPT_LONG 1

/* macOS-specific functions */
#ifdef __APPLE__
#define HAVE_GETHOSTBYNAME2 1
#define HAVE_UTMPXNAME 1
/* HAVE_UPDWTMPX - not available on macOS */
#define HAVE_PUTUTLINE 1
#define HAVE_SETUTENT 1
#define HAVE_ENDUTENT 1
#endif

/* Types */
#define HAVE__BOOL 1
#define HAVE_STDBOOL_H 1

/* Struct members - macOS specifics */
#ifdef __APPLE__
#define HAVE_STRUCT_ETHER_ADDR_OCTET 1
#define HAVE_STRUCT_IFREQ_IFR_HWADDR 0
#define HAVE_STRUCT_UTMP_UT_TIME 1
#define HAVE_STRUCT_NTPTIMEVAL_TAI 1
#endif

/* POSIX timers - not reliably available on macOS */
#ifdef __APPLE__
#define HAVE_DECL_POSIX_TIMERS_SUPPORTED 0
#else
#define HAVE_DECL_POSIX_TIMERS_SUPPORTED 1
#endif

/* MSG_ERRQUEUE for SO_TIMESTAMPING (Linux only) */
#ifdef __linux__
#define HAVE_DECL_MSG_ERRQUEUE 1
#else
#define HAVE_DECL_MSG_ERRQUEUE 0
#endif

/* Standard C library features */
#define HAVE_MALLOC 1
#define HAVE_WORKING_MEMCMP 1
#define RETSIGTYPE void
#define SELECT_TYPE_ARG1 int
#define SELECT_TYPE_ARG234 (fd_set *)
#define SELECT_TYPE_ARG5 (struct timeval *)

/* Define to 1 if you have the ANSI C header files. */
#define STDC_HEADERS 1

/* Define to empty if `const' does not conform to ANSI C. */
/* #undef const */

/* Define to `unsigned int' if <sys/types.h> does not define. */
/* #undef size_t */

/* Define to `int' if <sys/types.h> does not define. */
/* #undef ssize_t */

#endif /* CONFIG_H */
